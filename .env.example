# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Do not commit real keys.

# --- Cloud APIs ---

# OpenRouter — Mem0 fact extraction (always), and the main chat LLM if
# XAI_API_KEY (below) is not set.  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# xAI direct — when set, the main chat LLM routes to api.x.ai instead of
# OpenRouter (faster + ~20x cheaper per token than Claude per May 2026 research).
# Mem0 still uses OpenRouter regardless.  https://x.ai/api
# XAI_API_KEY=

# Groq — Whisper-large-v3-turbo (STT)
# https://console.groq.com/
GROQ_API_KEY=

# ElevenLabs v3 (TTS) + chosen voice
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cPoqAvGWCPfCfyPMwe4z

# ElevenLabs model. Default `eleven_flash_v2_5` (lowest latency, works on free
# tier; ElevenLabs recommends Flash over the older Turbo models it superseded).
# `eleven_v3` performs inline audio tags like [cackle]/[whispers] but requires
# alpha access — apply at elevenlabs.io. Other options: `eleven_multilingual_v2`.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Optional overrides ---

# Override the OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Override the chat LLM model.  Default depends on which provider is active:
#   * XAI_API_KEY set     → "grok-4.20-non-reasoning" (xAI direct)
#   * OpenRouter fallback → "anthropic/claude-sonnet-5"
# When routing via xAI: use plain Grok model names (e.g. "grok-4.20-non-reasoning",
# "grok-4.3").  When via OpenRouter: use prefixed names (e.g. "anthropic/claude-sonnet-5",
# "google/gemini-2.5-pro", "x-ai/grok-4.20").
# LLM_MODEL=

# --- Hardware backend ---

# `mock` (default on macOS) logs jaw angles to stdout.
# `pca9685` drives a real servo via I2C — set this on the Pi.
LARRY_HARDWARE=mock

# gpiozero pin factory. `mock` on Mac, `lgpio` on Pi 5.
GPIOZERO_PIN_FACTORY=mock

# OpenWakeWord pretrained model. Bundled with openwakeword 0.4.0:
# hey_jarvis, alexa, hey_mycroft, timer, weather. Default: hey_jarvis.
# WAKE_WORD_MODEL=hey_jarvis

# Path to a custom OpenWakeWord .onnx model (e.g. a trained "Hey Larry").
# Drop the downloaded .onnx into src/larry/wake_models/ and point this at it.
# Train via the patched 2026 fork (original Colab broke in 2023):
#   https://github.com/alfiedennen/openwakeword-colab-2026
# Edit TARGET_PHRASE="Hey Larry" + MODEL_NAME="hey_larry", Run All, ~75-90 min on Colab Pro L4.
# WAKE_WORD_CUSTOM_PATH=src/larry/wake_models/hey_larry.onnx

# --- Optional ---

# Mem0 — if using cloud Mem0 instead of self-hosted
# MEM0_API_KEY=
