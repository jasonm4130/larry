# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Do not commit real keys.

# --- Cloud APIs ---

# OpenRouter — chat LLM + Mem0 fact extraction (Larry's brain)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq — Whisper-large-v3-turbo (STT)
# https://console.groq.com/
GROQ_API_KEY=

# ElevenLabs v3 (TTS) + chosen voice
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cPoqAvGWCPfCfyPMwe4z

# Picovoice — Porcupine wake word "Hey Larry"
# https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=

# --- Optional overrides ---

# Override the OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Override the chat LLM model served via OpenRouter (default: anthropic/claude-sonnet-4-6)
# Swap to e.g. google/gemini-2.5-pro or x-ai/grok-3 without touching code.
# LLM_MODEL=anthropic/claude-sonnet-4-6

# --- Hardware backend ---

# `mock` (default on macOS) logs jaw angles to stdout.
# `pca9685` drives a real servo via I2C — set this on the Pi.
LARRY_HARDWARE=mock

# gpiozero pin factory. `mock` on Mac, `lgpio` on Pi 5.
GPIOZERO_PIN_FACTORY=mock

# --- Optional ---

# Mem0 — if using cloud Mem0 instead of self-hosted
# MEM0_API_KEY=
